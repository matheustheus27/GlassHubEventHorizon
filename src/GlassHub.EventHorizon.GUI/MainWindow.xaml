<Window x:Class="GlassHub.EventHorizon.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassHubEventHorizon - Cosmic Compression Suite" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDarkBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- GlassHub Header Component -->
        <Border Grid.Row="0" Background="{StaticResource CardGlassBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#4FACFE" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                            <TextBlock Text="GLASSHUB ECOSYSTEM" Foreground="White" FontWeight="Bold" FontSize="11"/>
                        </Border>
                        <TextBlock Text="GlassHubEventHorizon" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="High-Performance Stream-Based Compression &amp; Decryption Suite" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnLangEn" Content="🇺🇸 EN" Click="BtnLangEn_Click" Padding="12,6" Margin="0,0,8,0" Background="#2D3748" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="BtnLangPt" Content="🇧🇷 PT" Click="BtnLangPt_Click" Padding="12,6" Background="#2D3748" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body Work Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Compress Card Organism -->
            <Border Grid.Column="0" Background="{StaticResource CardGlassBrush}" CornerRadius="12" Padding="20" Margin="0,0,10,0" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="TxtCompressHeader" Text="📦 Compress Files (Compactar)" Foreground="{StaticResource NeonCyanBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Source Files / Folder Path:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtSourcePath" Padding="8" Background="#0D0F1A" Foreground="White" BorderBrush="{StaticResource GlassBorderBrush}" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Output Archive (.zip / .7z):" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtOutputPath" Padding="8" Background="#0D0F1A" Foreground="White" BorderBrush="{StaticResource GlassBorderBrush}" Margin="0,0,0,15"/>

                    <TextBlock Text="Password (Optional):" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="TxtCompressPassword" Padding="8" Background="#0D0F1A" Foreground="White" BorderBrush="{StaticResource GlassBorderBrush}" Margin="0,0,0,20"/>

                    <Button x:Name="BtnCompress" Content="🚀 Compress (Compactar)" Click="BtnCompress_Click" Padding="12" Background="#00F2FE" Foreground="Black" FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Extract Card Organism -->
            <Border Grid.Column="1" Background="{StaticResource CardGlassBrush}" CornerRadius="12" Padding="20" Margin="10,0,0,0" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="TxtExtractHeader" Text="📂 Extract Archive (Descompactar)" Foreground="{StaticResource NeonMagentaBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Archive File Path:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtExtractSource" Padding="8" Background="#0D0F1A" Foreground="White" BorderBrush="{StaticResource GlassBorderBrush}" Margin="0,0,0,15"/>

                    <TextBlock Text="Destination Directory:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtExtractDest" Padding="8" Background="#0D0F1A" Foreground="White" BorderBrush="{StaticResource GlassBorderBrush}" Margin="0,0,0,15"/>

                    <TextBlock Text="Password (If Encrypted):" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="TxtExtractPassword" Padding="8" Background="#0D0F1A" Foreground="White" BorderBrush="{StaticResource GlassBorderBrush}" Margin="0,0,0,20"/>

                    <Button x:Name="BtnExtract" Content="⚡ Extract (Descompactar)" Click="BtnExtract_Click" Padding="12" Background="#4FACFE" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status & Telemetry Footer -->
        <Border Grid.Row="2" Background="{StaticResource CardGlassBrush}" CornerRadius="12" Padding="15" Margin="0,20,0,0" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
            <TextBlock x:Name="TxtStatus" Text="Status: Ready | Motor Activo: GlassHub Smart Fallback Engine" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
