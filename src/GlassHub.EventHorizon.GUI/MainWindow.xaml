<Window x:Class="GlassHub.EventHorizon.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:GlassHub.EventHorizon.GUI.ViewModels"
        xmlns:views="clr-namespace:GlassHub.EventHorizon.GUI.Views"
        mc:Ignorable="d"
        Title="GlassHub Event Horizon" Height="680" Width="960"
        MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Icon="Assets/app.ico"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <!-- ViewModel to View Mapping -->
        <DataTemplate DataType="{x:Type viewmodels:CompressViewModel}">
            <views:CompressView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ExtractViewModel}">
            <views:ExtractView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:InspectViewModel}">
            <views:InspectView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <!-- Main Outer Window Border with Glassmorphic Backdrop and Rounded Corners -->
    <Border Background="{DynamicResource BackgroundDarkBrush}" 
            BorderBrush="{DynamicResource GlassBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/> <!-- TitleBar -->
                <RowDefinition Height="*"/>  <!-- Main Body (Sidebar + Content) -->
                <RowDefinition Height="32"/> <!-- Status Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Modern Windows 11 Custom TitleBar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Branding with Crisp High-Quality Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="Assets/logo.png" 
                           Width="20" Height="20" 
                           RenderOptions.BitmapScalingMode="HighQuality" 
                           Margin="0,0,8,0" 
                           VerticalAlignment="Center"/>
                    <TextBlock Text="GlassHub Event Horizon" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                        <TextBlock Text="v1.0.0 Cosmic" Foreground="{DynamicResource NeonCyanBrush}" FontSize="9" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Right: Window Chrome Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Padding="8,5" Margin="0,0,4,0" ToolTip="Minimizar">
                        <Path Data="{StaticResource IconMinimize}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Padding="8,5" Margin="0,0,4,0" ToolTip="Maximizar/Restaurar">
                        <Path Data="{StaticResource IconMaximize}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnClose" Click="BtnClose_Click" Padding="8,5" Background="#26FF4444" BorderBrush="#40FF4444" ToolTip="Fechar">
                        <Path Data="{StaticResource IconClose}" Stroke="#FFAAAA" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Windows 11 NavigationView Layout (Sidebar + Work Area) -->
            <Grid Grid.Row="1" Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/> <!-- Sidebar Navigation -->
                    <ColumnDefinition Width="*"/>   <!-- Main View Content Area -->
                </Grid.ColumnDefinitions>

                <!-- Sidebar Navigation Panel -->
                <Border Grid.Column="0" Background="{DynamicResource NavBackgroundDarkBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,12" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Section Title -->
                            <RowDefinition Height="*"/>    <!-- Top Nav Items -->
                            <RowDefinition Height="Auto"/> <!-- Bottom Settings -->
                        </Grid.RowDefinitions>

                        <!-- Nav Header -->
                        <TextBlock Grid.Row="0" Text="NAVEGAÇÃO" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold" Margin="8,0,0,8"/>

                        <!-- Navigation Items (Compress, Extract, Inspect) -->
                        <StackPanel Grid.Row="1">
                            <!-- 1. Compress -->
                            <Button Style="{StaticResource NavButtonStyle}" 
                                    Command="{Binding NavigateCompressCommand}"
                                    Tag="{Binding IsCompressActive}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCompress}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Compactar" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. Extract -->
                            <Button Style="{StaticResource NavButtonStyle}" 
                                    Command="{Binding NavigateExtractCommand}"
                                    Tag="{Binding IsExtractActive}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconExtract}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Extrair" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. Inspect -->
                            <Button Style="{StaticResource NavButtonStyle}" 
                                    Command="{Binding NavigateInspectCommand}"
                                    Tag="{Binding IsInspectActive}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconInspect}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Inspetor &amp; Análise" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Pinned Bottom Navigation Item: Settings -->
                        <StackPanel Grid.Row="2">
                            <Separator Background="{DynamicResource GlassBorderBrush}" Margin="0,4,0,8"/>
                            <Button Style="{StaticResource NavButtonStyle}" 
                                    Command="{Binding NavigateSettingsCommand}"
                                    Tag="{Binding IsSettingsActive}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconGear}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Configurações" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dynamic View Area -->
                <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
            </Grid>

            <!-- 3. Compact Translucent Status Bar Footer -->
            <Border Grid.Row="2" Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Width="6" Height="6" Background="{DynamicResource NeonCyanBrush}" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="GlassHub Cosmic Engine" Foreground="{DynamicResource NeonCyanBrush}" FontSize="10" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
