<Application x:Class="GlassHub.EventHorizon.GUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- GlassHub Glassmorphic Dark Theme Palette -->
        <Color x:Key="BackgroundDarkColor">#0D0F1A</Color>
        <Color x:Key="CardGlassBackground">#1A1D2F80</Color>
        <Color x:Key="NeonCyan">#00F2FE</Color>
        <Color x:Key="NeonMagenta">#4FACFE</Color>
        <Color x:Key="GlassBorderColor">#33FFFFFF</Color>

        <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDarkColor}"/>
        <SolidColorBrush x:Key="CardGlassBrush" Color="#1E2235"/>
        <SolidColorBrush x:Key="NeonCyanBrush" Color="{StaticResource NeonCyan}"/>
        <SolidColorBrush x:Key="NeonMagentaBrush" Color="{StaticResource NeonMagenta}"/>
        <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F4F8"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0AEC0"/>
    </Application.Resources>
</Application>
