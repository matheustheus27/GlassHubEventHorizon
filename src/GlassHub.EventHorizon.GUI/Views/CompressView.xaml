<UserControl x:Class="GlassHub.EventHorizon.GUI.Views.CompressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:GlassHub.EventHorizon.GUI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:CompressViewModel}"
             d:DesignHeight="600" d:DesignWidth="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">
            <!-- Header Title & Subtitle -->
            <TextBlock Text="Compactar &amp; Empacotar Arquivos" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="Crie arquivos compactados de alta densidade com compressão cósmica ultra-rápida." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16"/>

            <!-- 1. Interactive Cosmic Drop Zone -->
            <Border Background="{DynamicResource DropZoneBackgroundBrush}" 
                    BorderBrush="{DynamicResource NeonCyanBrush}" 
                    BorderThickness="1.5" 
                    CornerRadius="12" 
                    Padding="20,16" 
                    Margin="0,0,0,14" 
                    AllowDrop="True" 
                    Drop="DropZone_Drop" 
                    DragOver="DropZone_DragOver"
                    Cursor="Hand">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCompress}" Fill="{DynamicResource NeonCyanBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Arraste &amp; Solte Arquivos ou Pastas Aqui" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="ou use os botões abaixo para selecionar itens do computador" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,12"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Command="{Binding AddFilesCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Padding="14,7" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFile}" Fill="Black" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Adicionar Arquivos" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddFolderCommand}" Padding="14,7">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Adicionar Pasta"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 1-Click Quick Presets (Zero Friction for Beginners) -->
            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Presets Rápidos em 1 Clique:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PresetPillStyle}" 
                                Command="{Binding SelectPresetCommand}" 
                                CommandParameter="Balanced"
                                Tag="{Binding ActivePreset, Converter={StaticResource PresetActiveConv}, ConverterParameter=Balanced, Mode=OneWay, ConverterCulture=en-US}">
                            <TextBlock Text="⚖️ Balanceado (ZIP Normal)"/>
                        </Button>
                        <Button Style="{StaticResource PresetPillStyle}" 
                                Command="{Binding SelectPresetCommand}" 
                                CommandParameter="MinSize"
                                Tag="{Binding ActivePreset, Converter={StaticResource PresetActiveConv}, ConverterParameter=MinSize, Mode=OneWay, ConverterCulture=en-US}">
                            <TextBlock Text="🗜️ Tamanho Mínimo (7z Ultra)"/>
                        </Button>
                        <Button Style="{StaticResource PresetPillStyle}" 
                                Command="{Binding SelectPresetCommand}" 
                                CommandParameter="Fast"
                                Tag="{Binding ActivePreset, Converter={StaticResource PresetActiveConv}, ConverterParameter=Fast, Mode=OneWay, ConverterCulture=en-US}">
                            <TextBlock Text="⚡ Ultra Rápido (Veloz)"/>
                        </Button>
                        <Button Style="{StaticResource PresetPillStyle}" 
                                Command="{Binding SelectPresetCommand}" 
                                CommandParameter="Store"
                                Tag="{Binding ActivePreset, Converter={StaticResource PresetActiveConv}, ConverterParameter=Store, Mode=OneWay, ConverterCulture=en-US}">
                            <TextBlock Text="💎 Sem Perdas (Raw Store)"/>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 3. Staged Items List -->
            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14" Visibility="{Binding HasStagedItems, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Itens Selecionados:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="10" Padding="8,1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding StagedCount}" Foreground="{DynamicResource NeonCyanBrush}" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <Button Command="{Binding ClearListCommand}" Content="Limpar Todos" HorizontalAlignment="Right" Padding="8,3" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="#FF8888"/>
                    </Grid>

                    <Border Background="{DynamicResource BackgroundDarkBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" MaxHeight="140">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding StagedItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{StaticResource IconFile}" Fill="{DynamicResource NeonCyanBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Content="✕" 
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" 
                                                    Padding="6,2" FontSize="10" Background="Transparent" BorderThickness="0" Foreground="#FFAAAA"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. Progressive Disclosure: Advanced Settings Expander -->
            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,6" Margin="0,0,0,14">
                <Expander Header="⚙️ Opções Avançadas (Formato, Criptografia, Volumes &amp; Threads)">
                    <StackPanel Margin="0,10,0,6">
                        <!-- Formato, Nível e Senha -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Formato do Arquivo:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox SelectedIndex="{Binding SelectedFormatIndex}">
                                    <ComboBoxItem Content=".zip (Universal)"/>
                                    <ComboBoxItem Content=".7z (Alta Densidade)"/>
                                    <ComboBoxItem Content=".tar (POSIX Archive)"/>
                                    <ComboBoxItem Content=".gz (GZip Stream)"/>
                                    <ComboBoxItem Content=".zst (Zstandard)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                <TextBlock Text="Nível de Compressão:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox SelectedIndex="{Binding SelectedLevelIndex}">
                                    <ComboBoxItem Content="Normal (Balanceado)"/>
                                    <ComboBoxItem Content="Rápido (Veloz)"/>
                                    <ComboBoxItem Content="Ultra (Máximo)"/>
                                    <ComboBoxItem Content="Armazenar (Raw 0%)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="Senha AES-256 (Opcional):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Divisão em Volumes & Threads de Processamento -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Divisão em Volumes (Partes):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox SelectedIndex="{Binding SelectedVolumeSplitIndex}">
                                    <ComboBoxItem Content="Sem divisão (Arquivo Único)"/>
                                    <ComboBoxItem Content="Partes de 100 MB"/>
                                    <ComboBoxItem Content="Partes de 700 MB (CD)"/>
                                    <ComboBoxItem Content="Partes de 4.7 GB (DVD)"/>
                                    <ComboBoxItem Content="Personalizado..."/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Alocação de Threads de CPU:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedThreads}" Foreground="{DynamicResource NeonCyanBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider Minimum="1" Maximum="{Binding MaxThreads}" Value="{Binding SelectedThreads}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Caminho de Saída Manual -->
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Caminho do Arquivo de Destino:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Content="Procurar..." Command="{Binding BrowseOutputCommand}" Padding="10,6"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- 5. Action Execution Bar & Progress Feedback -->
            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <!-- Progress Bar (Visible during execution) -->
                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{Binding ProgressStatusText}" Foreground="{DynamicResource NeonCyanBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:0}%}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100"/>
                    </StackPanel>

                    <!-- Main Action Button -->
                    <Button Command="{Binding CompressCommand}" Style="{StaticResource PrimaryActionButtonStyle}" HorizontalAlignment="Stretch" Padding="14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconBolt}" Fill="Black" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="COMPACTAR AGORA" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
