<UserControl x:Class="GlassHub.EventHorizon.GUI.Views.ExtractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:GlassHub.EventHorizon.GUI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ExtractViewModel}"
             d:DesignHeight="600" d:DesignWidth="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">
            <!-- Header Title & Subtitle -->
            <TextBlock Text="Descompactar &amp; Extrair Arquivos" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="Extraia pacotes em alta velocidade com integridade CRC garantida e auto-detecção inteligente de pasta." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16"/>

            <!-- 1. Interactive Cosmic Drop Zone for Archives -->
            <Border Background="{DynamicResource DropZoneBackgroundBrush}" 
                    BorderBrush="{DynamicResource NeonMagentaBrush}" 
                    BorderThickness="1.5" 
                    CornerRadius="12" 
                    Padding="20,20" 
                    Margin="0,0,0,14" 
                    AllowDrop="True" 
                    Drop="DropZoneExtract_Drop" 
                    DragOver="DropZoneExtract_DragOver"
                    Cursor="Hand">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconExtract}" Fill="{DynamicResource NeonMagentaBrush}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Arraste o Arquivo Compactado Aqui para Extrair" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Suporta .zip, .7z, .rar, .tar, .gz, .zst, .bz2, .xz" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,12"/>
                        
                        <Button Command="{Binding BrowseSourceCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Background="{DynamicResource NeonMagentaBrush}" Foreground="White" Padding="16,8" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Selecionar Arquivo Compactado..." FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Source & Destination Information Card -->
            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Arquivo Selecionado -->
                    <TextBlock Text="Arquivo Compactado de Origem:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SourceArchivePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="Procurar..." Command="{Binding BrowseSourceCommand}" Padding="12,6"/>
                    </Grid>

                    <!-- Diretório de Destino -->
                    <TextBlock Text="Diretório de Destino da Extração:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding DestinationDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="Alterar Pasta..." Command="{Binding BrowseDestinationCommand}" Padding="12,6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Advanced Security / Password Expander -->
            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,6" Margin="0,0,0,14">
                <Expander Header="⚙️ Opções Avançadas (Senha de Descriptografia AES-256)">
                    <StackPanel Margin="0,10,0,6">
                        <TextBlock Text="Senha de Descriptografia (Se o arquivo for protegido):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- 4. Action Execution Bar & Progress Feedback -->
            <Border Background="{DynamicResource CardGlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <!-- Progress Bar (Visible during execution) -->
                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{Binding ProgressStatusText}" Foreground="{DynamicResource NeonMagentaBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:0}%}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Foreground="{DynamicResource NeonMagentaBrush}"/>
                    </StackPanel>

                    <!-- Main Extract Button -->
                    <Button Command="{Binding ExtractCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Background="{DynamicResource NeonMagentaBrush}" Foreground="White" HorizontalAlignment="Stretch" Padding="14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconBolt}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="EXTRAIR AGORA" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
